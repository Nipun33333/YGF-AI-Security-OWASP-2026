# COPY TO .env LOCALLY. NEVER COMMIT REAL KEYS.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
GEMINI_MODEL=gemini-3.8-flash

# OFF by default: enabling Claude consumes paid/trial credits.
ALLOW_PAID_CLAUDE=false
# Gemini automatically tries up to seven reviewed free-tier-eligible models.
# A billing-enabled AI Studio project may charge despite a model's free-tier listing.
